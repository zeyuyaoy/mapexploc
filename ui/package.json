{
  "name": "mapexploc-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "vite --host 127.0.0.1",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "pnpm examples:check && pnpm format:check && pnpm lint && pnpm test && pnpm build",
    "test:e2e": "playwright test",
    "format": "prettier --write src e2e scripts *.js *.json *.yaml",
    "format:check": "prettier --check src e2e scripts *.js *.json *.yaml",
    "examples:sync": "node scripts/sync-examples.mjs",
    "examples:check": "node scripts/sync-examples.mjs --check"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "prettier": "3.9.7",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24 <25"
  }
}
