{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "ui",
      "framework": "vite",
      "installCommand": "npx --yes pnpm@11.18.0 install --frozen-lockfile",
      "buildCommand": "npx --yes pnpm@11.18.0 build",
      "outputDirectory": "dist"
    },
    "api": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "app:app",
      "functions": {
        "app.py": {
          "maxDuration": 60,
          "includeFiles": "{config/default-model.json,examples/models/human-baseline.joblib}",
          "excludeFiles": "{ui/**,tests/**,docs/**,scripts/**,artifacts/**,results/**,examples/baseline/**,examples/experiments/**,examples/validation/**,examples/adapters/**,.venv*/**,.git/**,dist/**,build/**,site/**}"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": { "service": "api" } },
    { "source": "/:path*", "destination": { "service": "web" } }
  ]
}
